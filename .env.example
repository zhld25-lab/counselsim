# Copy this file to .env and fill in ONE key. Never commit the real .env.
#
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env
#
# The provider is inferred from whichever key is present, so one line is
# usually enough. Verify with:  python tools/check_key.py

# ---------------------------------------------------------------------------
# Option A - Groq (default; free, email signup at https://console.groq.com/keys)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Option B - Google Gemini (https://aistudio.google.com/apikey)
# Also requires: pip install google-genai
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Option C - any other OpenAI-compatible endpoint
# (OpenRouter, DeepSeek, Moonshot, Zhipu, a local vLLM/Ollama, OpenAI itself)
# Set BOTH of these.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Force a provider instead of inferring it: gemini | groq | openai
# LLM_PROVIDER=

# ---------------------------------------------------------------------------
# Model ids. Leave blank to use the per-provider defaults in backend/config.py.
# `python tools/check_key.py` prints the ids your key can actually reach.
# ---------------------------------------------------------------------------
# CLIENT_MODEL=
# COUNSELOR_MODEL=
# SUPERVISOR_MODEL=

# Seconds before a single LLM call is abandoned
LLM_TIMEOUT=30

# Set to 1 to force the offline scripted LLM even when a key is present
FORCE_MOCK=0

# Signs the auth tokens - change this in any real deployment
SECRET_KEY=counselsim-dev-secret-change-me

# Optional: where the SQLite file lives
# DB_PATH=./counselsim.db
